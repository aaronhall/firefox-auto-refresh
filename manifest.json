{
  "manifest_version": 3,
  "name": "Auto Refresh — Page & Domain Timer",
  "version": "1.0.0",
  "description": "Auto-refresh any page or entire domain at custom intervals you control.",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Auto Refresh",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.svg",
      "96": "icons/icon-96.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-refresh-page-domain@example.local",
      "strict_min_version": "109.0"
    }
  }
}
