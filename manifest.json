{
  "manifest_version": 3,
  "name": "Auto Refresh — Per-Tab Timer",
  "version": "1.1",
  "description": "Auto-refresh the current tab at custom intervals, optionally locked to the page or domain.",
  "permissions": ["tabs"],
  "background": {
    "scripts": ["utils.js", "background.js"]
  },
  "action": {
    "default_title": "Auto Refresh",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48-gray.svg",
      "96": "icons/icon-96-gray.svg"
    }
  },
  "icons": {
    "48": "icons/icon-48.svg",
    "96": "icons/icon-96.svg"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "auto-refresh-page-domain@example.local",
      "strict_min_version": "109.0"
    }
  }
}
